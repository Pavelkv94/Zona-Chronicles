{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./secrets/**)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "ask": ["Bash(git push:*)", "Bash(pnpm install:*)", "Bash(pnpm add:*)", "Bash(npm install:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/agent-harness/src/hooks/pre-tool-use-write.ts"],
            "timeout": 15,
            "statusMessage": "Проверка write set..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/agent-harness/src/hooks/pre-tool-use-bash.ts"],
            "timeout": 15,
            "statusMessage": "Проверка операций lead-only..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/agent-harness/src/hooks/subagent-stop-writeset.ts"
            ],
            "timeout": 30,
            "statusMessage": "Сверка diff с declared write set..."
          }
        ]
      }
    ]
  }
}
