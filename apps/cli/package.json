{
  "name": "@zona/cli",
  "version": "0.0.0",
  "private": true,
  "description": "seed, run, replay, inspect, export.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@zona/contracts": "workspace:*",
    "@zona/domain": "workspace:*",
    "@zona/simulation": "workspace:*",
    "@zona/persistence": "workspace:*",
    "@zona/projections": "workspace:*"
  }
}
