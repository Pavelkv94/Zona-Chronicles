{
  "name": "@zona/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Канонический scheduler worker и projection builders.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@zona/contracts": "workspace:*",
    "@zona/domain": "workspace:*",
    "@zona/simulation": "workspace:*",
    "@zona/persistence": "workspace:*",
    "@zona/projections": "workspace:*",
    "@zona/representation": "workspace:*",
    "pino": "10.3.1",
    "@zona/content": "workspace:*"
  }
}
