{
  "name": "@zona/persistence",
  "version": "0.0.0",
  "private": true,
  "description": "Kysely repositories, транзакции, outbox и migration runner (I02A).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@zona/contracts": "workspace:*",
    "@zona/domain": "workspace:*",
    "kysely": "0.29.5",
    "pg": "8.23.0"
  }
}
