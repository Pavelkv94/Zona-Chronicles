{
  "name": "@zona/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Чистые сущности, команды, события и инварианты (I01).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
